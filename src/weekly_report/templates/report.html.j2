<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Weekly app report, {{ report.period.label() }}</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body {
  margin: 0 auto;
  max-width: 900px;
  padding: 24px 16px 40px;
  font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #1d1d1b;
  background: #f6f5f1;
}
header h1 { margin: 0; font-size: 22px; }
header p { margin: 4px 0 20px; color: #6b6a65; }
h2 { margin: 0 0 12px; font-size: 18px; }
h3 { margin: 0 0 10px; font-size: 14px; display: flex; justify-content: space-between; gap: 12px; }
h3 .range { font-weight: normal; color: #6b6a65; }
.problems { background: #fdecea; border: 1px solid #f1b8b2; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; }
.problems h2 { color: #b3261e; font-size: 15px; margin-bottom: 6px; }
.problems ul { margin: 0; padding-left: 18px; }
.app { margin-bottom: 24px; }
.app + .app { break-before: page; }
.card { background: #fff; border: 1px solid #e1e0d9; border-radius: 10px; padding: 14px 16px; break-inside: avoid; }
.figure { display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: 16px; align-items: center; }
.value { font-size: 34px; font-weight: 600; font-variant-numeric: tabular-nums; }
.label { color: #6b6a65; }
.change { font-variant-numeric: tabular-nums; white-space: nowrap; }
.change.up { color: #00691e; }
.change.down { color: #b3261e; }
.change.flat { color: #6b6a65; }
.was { color: #6b6a65; font-size: 12px; }
.error { color: #b3261e; margin: 0; }
.chart { position: relative; break-inside: avoid; }
.chart canvas { display: block; }
@page { size: A4; margin: 12mm; }
@media print {
  body { background: #fff; max-width: none; padding: 0; }
  .chart canvas { width: 100% !important; height: auto !important; }
}
</style>
</head>
<body>
<header>
  <h1>Weekly app report</h1>
  <p>{{ report.period.label() }} · generated {{ report.generated.strftime("%Y-%m-%d %H:%M") }}</p>
</header>
{% if report.problems %}
<section class="problems">
  <h2>Problems</h2>
  <ul>
  {% for app, failure in report.problems %}
    <li><b>{{ app }}</b>, {{ failure.source }}: {{ failure.error }}</li>
  {% endfor %}
  </ul>
</section>
{% endif %}
{% for app in report.apps %}
<section class="app">
  <h2>{{ app.app }}</h2>
  {% set growth = app.growth %}
  <section class="card">
  {% if growth is failure %}
    <h3>Play: growth</h3>
    <p class="error">{{ growth.source }}: {{ growth.error }}</p>
  {% else %}
    {% set installs = growth.installs %}
    {% set direction = "up" if installs.change > 0 else ("down" if installs.change < 0 else "flat") %}
    <h3>Play: growth <span class="range">{{ growth.period.label() }}</span></h3>
    <div class="figure">
      <div>
        <div class="label">New installs</div>
        <div class="value">{{ installs.value | count }}</div>
        <div class="change {{ direction }}">{{ installs.change | signed }}{% if installs.percent_change is not none %} ({{ installs.percent_change | signed(1, "%") }}){% endif %}</div>
        <div class="was">{{ installs.previous | count }} the week before</div>
      </div>
      <div class="chart"><canvas id="{{ chart(installs.series, "New installs") }}" role="img" aria-label="Daily new installs"></canvas></div>
    </div>
  {% endif %}
  </section>
</section>
{% endfor %}
<script>{{ chart_js | safe }}</script>
<script>
Chart.defaults.animation = false;
Chart.defaults.devicePixelRatio = 2;
Chart.defaults.font.family = 'system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
Chart.defaults.color = "#6b6a65";
Chart.defaults.borderColor = "#e1e0d9";
const CHARTS = {{ charts | tojson }};
for (const [id, config] of CHARTS) {
  new Chart(document.getElementById(id), config);
}
</script>
</body>
</html>
